# LLM Configuration
LLM_PROVIDER=openai  # Options: openai, anthropic, deepseek
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Stockfish Configuration
STOCKFISH_PATH=/path/to/stockfish  # Path to Stockfish executable
STOCKFISH_DEPTH=15

# Generation Parameters
DEFAULT_STYLE=tal
DEFAULT_AGGRESSION=7
DEFAULT_CHAOS=5
DEFAULT_GAME_LENGTH=40  # Half-moves

# Export Settings
EXPORT_FORMAT=pgn  # pgn, json, markdown
ENABLE_VISUALIZATION=true
